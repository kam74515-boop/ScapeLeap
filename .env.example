# ScapeLeap runs entirely on infrastructure you control.
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# PostgreSQL on your machine or private server.
DATABASE_URL=postgresql://scapeleap:change-me@127.0.0.1:5432/scapeleap

# Optional SMTP relay. Leave empty in local development to log email previews.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ScapeLeap <hello@example.com>

# Optional S3-compatible storage. MinIO can be hosted on the same server.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=scapeleap
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional AI providers. Configure only the providers you want to use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional Stripe subscription adapter. Leave empty to use manual billing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STUDIO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=

NEXT_PUBLIC_LOGGING_LEVEL=info
NEXT_TELEMETRY_DISABLED=1
