{
  "name": "scapeleap",
  "version": "0.1.0",
  "private": true,
  "description": "ScapeLeap — AI Studio OS for interior design teams",
  "author": "ScapeLeap",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev:next": "next dev",
    "dev": "run-p db-server:file dev:next",
    "build:next": "next build",
    "build-local": "run-p db-server:memory build:next --race",
    "build": "run-s db:migrate build:next",
    "start": "next start -H 0.0.0.0",
    "build-stats": "cross-env ANALYZE=true npm run build",
    "clean": "rimraf .next out coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:types": "tsc --noEmit --pretty",
    "check:deps": "knip",
    "check:i18n": "i18n-check -l src/locales -s zh -u src -f next-intl",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:e2e": "playwright test",
    "db-server:file": "pglite-server -m 100 --db=local.db --run 'npm run db:migrate'",
    "db-server:memory": "pglite-server -m 100 --run 'npm run db:migrate'",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -c -- drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.2",
    "@logtape/logtape": "^2.3.2",
    "@radix-ui/react-slot": "^1.3.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "better-auth": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.35.0",
    "next": "^16.3.3",
    "next-intl": "^4.14.1",
    "pg": "^8.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "server-only": "^0.0.1",
    "stripe": "^22.6.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@eslint-react/eslint-plugin": "^5.18.6",
    "@lingual/i18n-check": "^0.9.5",
    "@next/bundle-analyzer": "^16.3.3",
    "@next/eslint-plugin-next": "^16.3.3",
    "@playwright/test": "^1.62.1",
    "@swc/helpers": "^0.5.23",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^25.9.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^4.1.11",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.1",
    "eslint-plugin-better-tailwindcss": "^4.6.0",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-playwright": "^2.10.4",
    "eslint-plugin-react-refresh": "^0.5.5",
    "knip": "^6.33.0",
    "lefthook": "^2.1.12",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.2.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "postcss": "8.5.24",
    "sharp": "0.35.3",
    "valibot": "1.4.2"
  },
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  }
}
